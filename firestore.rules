rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCIONES HELPER ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Comprueba si el documento del usuario existe en /team/{uid}
    function hasTeamDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/team/$(request.auth.uid));
    }

    // Obtiene los datos del documento de equipo
    function myTeamData() {
      return get(/databases/$(database)/documents/team/$(request.auth.uid)).data;
    }

    // Usuario autenticado y aprobado por un administrador
    function isApproved() {
      return hasTeamDoc() && myTeamData().aprobado == true;
    }

    // Usuario autenticado, aprobado y con rol de admin
    function isAdmin() {
      return isApproved() && myTeamData().role == "admin";
    }

    // --- REGLAS DE COLECCIONES ---

    // Colección de usuarios / equipo
    match /team/{userId} {
      // Cualquier usuario autenticado puede leer la lista de usuarios (ej. para pantallas de gestión)
      allow read: if isSignedIn();

      // Registro inicial: Un usuario nuevo solo puede crear su propio perfil y siempre con aprobado = false
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && request.resource.data.aprobado == false;

      // Actualizaciones de perfil:
      // 1. Un admin puede modificar cualquier campo (aprobar, cambiar roles, etc.).
      // 2. El propio usuario puede editar sus datos, siempre que:
      //    - No se intente asignar el rol "admin"
      //    - No intente auto-aprobarse (pasar de false a true)
      allow update: if isAdmin() || (
        isSignedIn() 
        && request.auth.uid == userId 
        && request.resource.data.role != "admin" 
        && (request.resource.data.aprobado == false || request.resource.data.aprobado == resource.data.aprobado)
      );

      // Solo administradores pueden eliminar usuarios del equipo
      allow delete: if isAdmin();
    }

    // Módulos operacionales: Mantenimiento (tasks), Materiales, Producción y Calidad
    match /tasks/{taskId} {
      allow read, write: if isApproved();
    }

    match /materials/{materialId} {
      allow read, write: if isApproved();
    }

    match /production_orders/{orderId} {
      allow read, write: if isApproved();
    }

    match /quality_issues/{issueId} {
      allow read, write: if isApproved();
    }
  }
}
