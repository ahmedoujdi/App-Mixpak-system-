rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function myTeamDoc() {
      return get(/databases/$(database)/documents/team/$(request.auth.uid));
    }
    function isApproved() {
      return isSignedIn() && myTeamDoc().data.aprobado == true;
    }
    function isAdmin() {
      return isSignedIn() && myTeamDoc().data.role == "admin" && myTeamDoc().data.aprobado == true;
    }

    // Rol/categoría y estado de aprobación de cada persona
    match /team/{userId} {
      allow read: if isSignedIn();
      // al crear su propia cuenta, siempre queda sin aprobar
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.aprobado == false;
      // cada uno puede editar su propio documento (p. ej. cambiar de categoría),
      // pero NO puede aprobarse a sí mismo; solo un admin puede tocar "aprobado"
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && request.resource.data.aprobado == resource.data.aprobado);
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read, write: if isApproved();
    }
    match /materials/{materialId} {
      allow read, write: if isApproved();
    }
    match /production_orders/{orderId} {
      allow read, write: if isApproved();
    }
    match /quality_issues/{issueId} {
      allow read, write: if isApproved();
    }
  }
}
