rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada quien puede leer y crear SU PROPIO perfil (para registrarse),
    // pero solo un admin ya aprobado puede aprobar/editar el rol de otros.
    match /team/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && esAdminAprobado();
      // Permite que la propia persona lea su estado, pero no se auto-apruebe:
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.aprobado == resource.data.aprobado
                    && request.resource.data.rol == resource.data.rol;
    }

    // Todo lo demás (mantenimiento, materiales, produccion, calidad, etc.)
    // solo accesible para usuarios aprobados.
    match /{document=**} {
      allow read, write: if request.auth != null && estaAprobado();
    }

    function estaAprobado() {
      return exists(/databases/$(database)/documents/team/$(request.auth.uid))
        && get(/databases/$(database)/documents/team/$(request.auth.uid)).data.aprobado == true;
    }

    function esAdminAprobado() {
      return estaAprobado()
        && get(/databases/$(database)/documents/team/$(request.auth.uid)).data.rol == "admin";
    }
  }
}
