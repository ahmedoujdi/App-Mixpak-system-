rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ⚠️ MODO PRUEBA — reglas abiertas temporalmente para poder usar la app
    // sin haber creado usuarios en Authentication todavía.
    // EN CUANTO tengas técnicos reales creados en Authentication, cambia
    // "allow read, write: if true;" por "allow read, write: if request.auth != null;"
    // en cada bloque de abajo, y publica de nuevo.
    match /tasks/{taskId} {
      allow read, write: if true;
    }
    match /materials/{materialId} {
      allow read, write: if true;
    }
    match /production_orders/{orderId} {
      allow read, write: if true;
    }
    match /quality_issues/{issueId} {
      allow read, write: if true;
    }
    // Rol/categoría de cada persona (mecánico, calidad, producción, almacén, supervisor)
    match /team/{userId} {
      allow read, write: if true;
    }
  }
}
